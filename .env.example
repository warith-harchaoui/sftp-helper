# .env.example
# ------------
# Environment-variable template for sftp-helper credentials.
# Copy to `.env` (gitignored) and fill in your values:
#     cp .env.example .env
#
# sftp-helper resolves credentials via os_helper.get_config in this order:
#   1. an explicit --config path   2. environment variables   3. a .env file
# See sftp_config.yaml.example for the fully-commented reference.

# ---- REQUIRED ----
SFTP_HOST=sftp.example.com
SFTP_LOGIN=your-login
SFTP_HTTPS=https://files.example.com

# ---- AUTHENTICATION (optional; pick one) ----
# Recommended: point SFTP_KEY at your PUBLIC key. OpenSSH delegates the
# signature to your SSH agent / hardware token, so no private-key material is
# ever named here. The matching private key must be loaded in your agent, and
# the public key installed in the server's ~/.ssh/authorized_keys.
#
# No key yet? Generate one (same command on macOS, Ubuntu and Windows):
#   ssh-keygen -t ed25519 -C "you@example.com"
# Load the private key into the agent:
#   macOS  : ssh-add --apple-use-keychain ~/.ssh/id_ed25519
#   Ubuntu : eval "$(ssh-agent -s)" && ssh-add ~/.ssh/id_ed25519
#   Windows: Start-Service ssh-agent; ssh-add $HOME\.ssh\id_ed25519   (PowerShell)
# Install the public key on the server:
#   macOS/Ubuntu: ssh-copy-id -i ~/.ssh/id_ed25519.pub your-login@sftp.example.com
#   Windows     : type $HOME\.ssh\id_ed25519.pub | ssh your-login@sftp.example.com "mkdir -p ~/.ssh && cat >> ~/.ssh/authorized_keys"
SFTP_KEY=~/.ssh/id_ed25519.pub

# Password fallback (needs `sshpass`); leave empty to use key/agent auth.
# SFTP_PASSWD=

# ---- OPTIONAL ----
# SFTP_DESTINATION_PATH=      # default: server root "/"
# SFTP_PORT=22                # default: 22
# SFTP_KNOWN_HOSTS=           # extra known_hosts file to trust
